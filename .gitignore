# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
/tmp
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets) — only the empty template is tracked
.env*
!.env.example

# vercel / supabase local state
.vercel
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Private / real data — never commit
# ---------------------------------------------------------------------------
# Local test output (generated certificates with real names)
/scratch/
# Real or signed certificate templates. Only blank samples are tracked;
# customer templates live in private Supabase Storage.
/public/*.pdf
/public/*.png
/public/*.jpg
/public/templates/
# Screenshots may contain attendee names / roll numbers
/docs/screenshots/
# Data exports
*.csv
!/docs/samples/*.csv
