# Copy to .env.local (local dev) and fill in. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.

# --- Supabase (server only) -------------------------------------------------
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → service_role / secret key. SERVER ONLY. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser-safe, used by @supabase/ssr Auth) --------------------
# Same Project URL as above
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → anon / publishable key (safe to expose; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App & Billing / Cron ---------------------------------------------------
# http://localhost:3000 locally, https://<your-app>.vercel.app in production
NEXT_PUBLIC_APP_URL=
# Secret sent by Vercel Cron in `Authorization: Bearer <CRON_SECRET>` for /api/cron/check-expiring-plans
CRON_SECRET=
# Comma-separated emails allowed to approve/reject manual payment_requests in /dashboard/billing
SUPER_ADMIN_EMAILS=

# --- Legacy single-event display settings (TODO(saas): remove in events phase)
# Public page heading — replaced by per-event title/subtitle in the DB.
SEMINAR_TITLE=
SEMINAR_SUBTITLE=
# Optional homepage footer text
FOOTER_HELP_TEXT=
FOOTER_CREDIT_TEXT=
